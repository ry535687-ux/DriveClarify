# DriveClarify repository boundary
# Historical runtime evidence remains on disk and is read-only, but is not
# tracked by this design/offline-evaluator repository.
/runtime/
/workspace/

# Host-uploaded research sources are immutable review inputs, not repository
# deliverables. Their identities are recorded in the design audit documents.
/DriveClarify_host_upload_pack/

# Pre-existing OpenArm packaging material is outside the DriveClarify contract.
/docker/
/docs/
/patches/
/scripts/
/HANDOFF.md
/Makefile
/.dockerignore

