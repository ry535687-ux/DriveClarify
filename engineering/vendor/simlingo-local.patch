+class RouteTraceConverter(object):
+    """Pure representation conversion from a GRP trace to SimLingo route rows."""
+
+    @staticmethod
+    def convert(fresh_route, world_to_planner_translation_xyz_m=None):
+        if isinstance(fresh_route, (str, bytes, bytearray)):
+            raise OnlineRouteUpdateError('FRESH_ROUTE_INVALID')
+        try:
+            rows = tuple(fresh_route)
+        except TypeError as error:
+            raise OnlineRouteUpdateError('FRESH_ROUTE_INVALID') from error
+        if not rows:
+            raise OnlineRouteUpdateError('FRESH_ROUTE_EMPTY')
+
+        if world_to_planner_translation_xyz_m is None:
+            translation = np.zeros(3, dtype=np.float64)
+        else:
+            try:
+                translation = np.asarray(
+                    world_to_planner_translation_xyz_m, dtype=np.float64
+                )
+            except (TypeError, ValueError) as error:
+                raise OnlineRouteUpdateError(
+                    'WORLD_TO_ROUTE_PLANNER_TRANSLATION_INVALID'
+                ) from error
+            if translation.shape != (3,) or not np.isfinite(translation).all():
+                raise OnlineRouteUpdateError(
+                    'WORLD_TO_ROUTE_PLANNER_TRANSLATION_INVALID'
+                )
+
+        converted = []
+        road_options = []
+        geometry = []
+        for row in rows:
+            if not isinstance(row, (tuple, list)) or len(row) != 2:
+                raise OnlineRouteUpdateError('FRESH_ROUTE_ROW_INVALID')
+            waypoint, command = row
+            try:
+                location = waypoint.transform.location
+            except AttributeError as error:
+                # Existing sealed native routes are represented as
+                # ``(carla.Transform, RoadOption)`` rows, while GRP traces use
+                # ``(carla.Waypoint, RoadOption)``.  Both carry the same CARLA
+                # world location and are representation inputs to this one
+                # converter, not distinct planners or route-generation paths.
+                try:
+                    location = waypoint.location
+                except AttributeError:
+                    raise OnlineRouteUpdateError(
+                        'FRESH_ROUTE_WAYPOINT_INVALID'
+                    ) from error
+            position = (
+                _endpoint_xyz(location, 'FRESH_ROUTE_WAYPOINT') + translation
+            )
+            road_option = _road_option_token(command)
+            converted.append((position, command))
+            road_options.append(road_option)
+            geometry.append([float(value).hex() for value in position])
+
+        distances = [0.0]
+        for index in range(1, len(converted)):
+            delta = converted[index][0] - converted[index - 1][0]
+            distance = float(np.linalg.norm(delta[:2]))
+            if not math.isfinite(distance):
+                raise OnlineRouteUpdateError('FRESH_ROUTE_DISTANCE_INVALID')
+            distances.append(distance)
+
+        road_option_digest = hashlib.sha256(json.dumps(
+            road_options, sort_keys=True, separators=(',', ':')
+        ).encode('utf-8')).hexdigest()
+        geometry_digest = hashlib.sha256(json.dumps(
+            geometry, separators=(',', ':')
+        ).encode('utf-8')).hexdigest()
+        converted_tuple = tuple(converted)
+        return PreparedRouteState(
+            route=converted_tuple,
+            route_distances=tuple(distances),
+            route_identity=_route_identity(converted_tuple),
+            road_option_sequence_digest=road_option_digest,
+            geometry_digest=geometry_digest,
+        )
