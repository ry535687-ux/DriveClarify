+class OnlineRouteUpdateError(ValueError):
+    """Fail-closed error raised before an active navigation route is changed."""
+
+
+def _endpoint_xyz(endpoint, label):
+    """Read a CARLA-style endpoint without changing its coordinate frame."""
+    try:
+        values = (
+            float(endpoint.x),
+            float(endpoint.y),
+            float(getattr(endpoint, 'z', 0.0)),
+        )
+    except (AttributeError, TypeError, ValueError):
+        try:
+            values = tuple(float(value) for value in endpoint[:3])
+        except (IndexError, TypeError, ValueError) as error:
+            raise OnlineRouteUpdateError(label + '_INVALID') from error
+    if len(values) != 3 or not np.isfinite(np.asarray(values)).all():
+        raise OnlineRouteUpdateError(label + '_INVALID')
+    return np.asarray(values, dtype=np.float64)
+
+
+def _road_option_token(command):
+    value = getattr(command, 'value', None)
+    name = getattr(command, 'name', None)
+    if value is None and name is None:
+        raise OnlineRouteUpdateError('FRESH_ROUTE_ROAD_OPTION_INVALID')
+    return {'name': None if name is None else str(name), 'value': value}
+
+
+def _route_identity(route):
+    payload = []
+    for position, command in route:
+        payload.append({
+            'xyz_hex': [float(value).hex() for value in position],
+            'road_option': _road_option_token(command),
+        })
+    encoded = json.dumps(payload, sort_keys=True, separators=(',', ':')).encode('utf-8')
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _distance_digest(distances):
+    encoded = json.dumps(
+        [float(value).hex() for value in distances],
+        separators=(',', ':'),
+    ).encode('utf-8')
+    return hashlib.sha256(encoded).hexdigest()
+
+
+@dataclass(frozen=True)
+class PreparedRouteState:
+    """Fully validated state that can be installed without further computation."""
+
+    route: tuple
+    route_distances: tuple
+    route_identity: str
+    road_option_sequence_digest: str
+    geometry_digest: str
+
