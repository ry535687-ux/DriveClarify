@@ -93,6 +93,42 @@ class WaypointInputAdaptor(nn.Module):
         return x
 
 
+class RouteSwitchResidualAdapter(nn.Module):
+    """Apply the frozen A1 residual to existing target-point embeddings.
+
+    The module does not create tokens or inspect route/map identity.  Missing,
+    malformed, disabled, or non-boolean markers fail safely to the exact input.
+    """
+
+    def __init__(self, hidden_size: int = 896, enabled: bool = False):
+        super().__init__()
+        if hidden_size != 896:
+            raise ValueError("ROUTE_SWITCH_HIDDEN_SIZE_MUST_BE_896")
+        self.hidden_size = hidden_size
+        self.enabled = bool(enabled)
+        self.delta_switch = nn.Parameter(torch.zeros(hidden_size))
+
+    def forward(self, target_embeddings: Tensor, route_switch_active=None) -> Tensor:
+        if not self.enabled:
+            return target_embeddings
+        if not isinstance(route_switch_active, Tensor):
+            return target_embeddings
+        if route_switch_active.dtype is not torch.bool:
+            return target_embeddings
+        if route_switch_active.ndim != 2 or route_switch_active.shape != (
+                target_embeddings.shape[0], 1):
+            return target_embeddings
+        if (target_embeddings.ndim != 3 or target_embeddings.shape[1] != 2
+                or target_embeddings.shape[-1] != self.hidden_size):
+            return target_embeddings
+        marker = route_switch_active.to(
+            device=target_embeddings.device, dtype=target_embeddings.dtype
+        ).unsqueeze(-1)
+        return target_embeddings + marker * self.delta_switch.to(
+            device=target_embeddings.device, dtype=target_embeddings.dtype
+        ).view(1, 1, -1)
+
+
