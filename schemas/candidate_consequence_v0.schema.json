{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driveclarify.local/schema/cp2/candidate_consequence_v0.schema.json",
  "title": "CandidateConsequenceV0",
  "description": "Adapter output per candidate. Envelope that wraps EVERY consequence field in a structured result (status/value/unit/frame/evidence_grade/dependencies/reason_code/source_artifacts). Currently-computable categories (integrity, raw_geometry) may carry values; physical-consequence categories (task/safety/rule/timing/recoverability/comfort) reference the frozen driveclarify.consequence.v0.1 semantics but MUST be UNKNOWN in v0 unless their dependency gate passes. Missing != zero; empty light != GREEN; unknown TTC != infinity; unknown collision != false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cache_id", "episode_id", "observation_id", "candidate_id",
    "computed_at_monotonic_ns", "integrity", "raw_geometry",
    "task", "safety", "rule", "timing", "recoverability", "comfort"
  ],
  "properties": {
    "schema_version": {"const": "driveclarify.candidate_consequence.v0"},
    "cache_id": {"type": "string", "minLength": 1, "description": "Links to Candidate Cache; mismatch => CACHE_CONSEQUENCE_ID_MISMATCH (reuses design/v0 x-cache-link-policy)."},
    "episode_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1, "description": "Shared observation; equals input metadata.observation_id."},
    "candidate_id": {"type": "string", "minLength": 1},
    "computed_at_monotonic_ns": {"type": "integer", "minimum": 0, "description": "MONOTONIC domain assembly time."},

    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_valid", "source_linkage_valid", "shape_valid", "stale", "missing_dependencies"],
      "properties": {
        "candidate_valid": {"$ref": "#/$defs/result"},
        "source_linkage_valid": {"$ref": "#/$defs/result"},
        "shape_valid": {"$ref": "#/$defs/result"},
        "stale": {"$ref": "#/$defs/result"},
        "missing_dependencies": {"$ref": "#/$defs/result", "description": "value is a list of blocking contract ids when present."}
      }
    },

    "raw_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_point_count", "speed_waypoint_count", "raw_route_length", "raw_adjacent_spacing", "pairwise_route_divergence_raw", "terminal_divergence_raw", "plan_continuity"],
      "properties": {
        "route_point_count": {"$ref": "#/$defs/result"},
        "speed_waypoint_count": {"$ref": "#/$defs/result"},
        "raw_route_length": {"$ref": "#/$defs/result"},
        "raw_adjacent_spacing": {"$ref": "#/$defs/result"},
        "pairwise_route_divergence_raw": {"$ref": "#/$defs/result"},
        "terminal_divergence_raw": {"$ref": "#/$defs/result"},
        "plan_continuity": {"$ref": "#/$defs/result"}
      }
    },

    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_target_identity", "target_topology", "route_branch_identity", "goal_equivalence", "wrong_goal_risk"],
      "properties": {
        "candidate_target_identity": {"$ref": "#/$defs/result"},
        "target_topology": {"$ref": "#/$defs/result"},
        "route_branch_identity": {"$ref": "#/$defs/result"},
        "goal_equivalence": {"$ref": "#/$defs/result"},
        "wrong_goal_risk": {"$ref": "#/$defs/result"}
      }
    },

    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["collision_status", "min_clearance", "ttc", "required_deceleration", "near_miss", "actor_conflict"],
      "properties": {
        "collision_status": {"$ref": "#/$defs/result"},
        "min_clearance": {"$ref": "#/$defs/result"},
        "ttc": {"$ref": "#/$defs/result"},
        "required_deceleration": {"$ref": "#/$defs/result"},
        "near_miss": {"$ref": "#/$defs/result"},
        "actor_conflict": {"$ref": "#/$defs/result"}
      }
    },

    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["red_light_conflict", "stop_sign_conflict", "lane_boundary_conflict", "off_road", "wrong_way", "camera_projection"],
      "properties": {
        "red_light_conflict": {"$ref": "#/$defs/result"},
        "stop_sign_conflict": {"$ref": "#/$defs/result"},
        "lane_boundary_conflict": {"$ref": "#/$defs/result"},
        "off_road": {"$ref": "#/$defs/result"},
        "wrong_way": {"$ref": "#/$defs/result"},
        "camera_projection": {"$ref": "#/$defs/result"}
      }
    },

    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["time_to_decision", "answer_deadline", "plan_age_sim", "adapter_latency_monotonic", "remaining_action_window"],
      "properties": {
        "time_to_decision": {"$ref": "#/$defs/result"},
        "answer_deadline": {"$ref": "#/$defs/result"},
        "plan_age_sim": {"$ref": "#/$defs/result"},
        "adapter_latency_monotonic": {"$ref": "#/$defs/result"},
        "remaining_action_window": {"$ref": "#/$defs/result"}
      }
    },

    "recoverability": {
      "type": "object", "additionalProperties": false,
      "required": ["recoverable_after_wait", "missed_opportunity", "alternative_available"],
      "properties": {
        "recoverable_after_wait": {"$ref": "#/$defs/result"},
        "missed_opportunity": {"$ref": "#/$defs/result"},
        "alternative_available": {"$ref": "#/$defs/result"}
      }
    },

    "comfort": {
      "type": "object", "additionalProperties": false,
      "required": ["acceleration_cost", "jerk_cost", "steering_smoothness"],
      "properties": {
        "acceleration_cost": {"$ref": "#/$defs/result"},
        "jerk_cost": {"$ref": "#/$defs/result"},
        "steering_smoothness": {"$ref": "#/$defs/result"}
      }
    }
  },

  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unit", "frame", "evidence_grade", "dependencies", "reason_code", "source_artifacts"],
      "properties": {
        "status": {"enum": ["AVAILABLE", "UNKNOWN", "UNSUPPORTED", "STALE", "INVALID"]},
        "value": {"description": "Physical/derived value ONLY when status=AVAILABLE; otherwise MUST be null.", "type": ["number", "integer", "boolean", "string", "array", "null"]},
        "unit": {"type": ["string", "null"], "description": "RAW_INDEX|RAW_UNIT|METRE|MPS|MPS2|MPS3|SECOND|second|SECOND_SIM|SECOND_MONOTONIC|class|boolean|identifier|null"},
        "frame": {"type": ["string", "null"], "description": "MODEL_LOCAL_RAW|EGO_LOCAL_UNCALIBRATED|CARLA_WORLD|CAMERA_FRAME|IMAGE_PIXEL|null"},
        "evidence_grade": {"enum": ["VERIFIED_FROM_CONTROLLED_PROBE", "SUPPORTED_BUT_INCOMPLETE", "UNRESOLVED_REQUIRES_ADDITIONAL_PROBE", "INVALIDATED_BY_CONTROLLED_PROBE", "NOT_CURRENTLY_AVAILABLE", "NOT_APPLICABLE"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "reason_code": {"type": ["string", "null"]},
        "source_artifacts": {"type": "array", "items": {"type": "string"}},
        "usage_purpose": {"type": ["string", "null"], "enum": ["AUTHORIZATION", "SAFETY_CRITICAL", "DIAGNOSTIC_ONLY", "LOGGING_ONLY", null], "description": "CAP-1/D03: WHY this value was computed. AUTHORIZATION/SAFETY_CRITICAL require VERIFIED; DIAGNOSTIC_ONLY/LOGGING_ONLY may use SUPPORTED but can never authorize."},
        "authorization_eligible": {"type": "boolean", "default": false, "description": "True ONLY for a usage_purpose=AUTHORIZATION, status=AVAILABLE, evidence VERIFIED result. Cannot be true for a diagnostic/logging value."},
        "safety_critical_eligible": {"type": "boolean", "default": false, "description": "True ONLY for a usage_purpose=SAFETY_CRITICAL, status=AVAILABLE, evidence VERIFIED result."},
        "clock_domain": {"type": ["string", "null"], "enum": ["SIM", "MONOTONIC", null], "description": "For time-valued results: which clock domain the value lives in (TIME_POLICY_V0)."},
        "limitations": {"type": ["string", "null"], "description": "Free-text note of what this value does NOT claim (e.g. latency is not a safety deadline)."}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "AVAILABLE"}}},
          "then": {"properties": {"reason_code": {"type": "null"}}, "not": {"properties": {"value": {"const": null}}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["UNKNOWN", "UNSUPPORTED", "STALE", "INVALID"]}}},
          "then": {"required": ["reason_code"], "properties": {"value": {"const": null}, "reason_code": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"authorization_eligible": {"const": true}}, "required": ["authorization_eligible"]},
          "then": {"properties": {"status": {"const": "AVAILABLE"}, "usage_purpose": {"const": "AUTHORIZATION"}, "evidence_grade": {"const": "VERIFIED_FROM_CONTROLLED_PROBE"}}}
        },
        {
          "if": {"properties": {"safety_critical_eligible": {"const": true}}, "required": ["safety_critical_eligible"]},
          "then": {"properties": {"status": {"const": "AVAILABLE"}, "usage_purpose": {"const": "SAFETY_CRITICAL"}, "evidence_grade": {"const": "VERIFIED_FROM_CONTROLLED_PROBE"}}}
        }
      ]
    }
  }
}
