{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "driveclarify.method_v1_r4.gpu_forward_record.v1",
  "type": "object",
  "required": [
    "ordinal", "fixture_id", "repeat_index", "candidate_order_index",
    "candidate_id", "interpretation_id", "prompt_text", "prompt_sha256",
    "semantic_digest", "input_bundle_sha256", "canonical_input",
    "source_observation", "provider_identity", "checkpoint_sha256",
    "execution_device", "dtype_device_autocast", "route", "speed",
    "finite_value_checks", "route_output_sha256", "speed_output_sha256",
    "combined_output_sha256", "provider_forward_count_after",
    "provider_forward_evidence", "preregistered_schedule_row_sha256",
    "record_sha256"
  ],
  "properties": {
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 48},
    "fixture_id": {"type": "string", "minLength": 1},
    "repeat_index": {"type": "integer", "minimum": 1, "maximum": 4},
    "candidate_order_index": {"type": "integer", "minimum": 0, "maximum": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "interpretation_id": {"type": "string", "minLength": 1},
    "prompt_text": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_input": {"type": "object"},
    "source_observation": {
      "type": "object",
      "required": ["observation_id", "frame_id"],
      "properties": {
        "observation_id": {"const": "R9-STATIC-TRAIN-OBSERVATION"},
        "frame_id": {"const": 410}
      },
      "additionalProperties": false
    },
    "provider_identity": {"const": "driveclarify_official_dreaming_adapter.adapter.OfficialDreamingCandidateForwardProvider"},
    "checkpoint_sha256": {"const": "ec8943723d266ee9f5f56f45d153a163b22616960bfccb741965ea5daa700d28"},
    "execution_device": {"const": "cuda:0"},
    "dtype_device_autocast": {"type": "object"},
    "route": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
    },
    "speed": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
    },
    "finite_value_checks": {
      "type": "object",
      "required": ["route", "speed"],
      "properties": {"route": {"const": true}, "speed": {"const": true}},
      "additionalProperties": false
    },
    "route_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "speed_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "combined_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_forward_count_after": {"type": "integer", "minimum": 1, "maximum": 48},
    "provider_forward_evidence": {"type": "object"},
    "preregistered_schedule_row_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
